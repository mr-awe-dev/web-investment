{
  "name": "personal-finance-app",
  "private": true,
  "version": "1.0.0",
  "description": "Monolithic personal finance + investment accounting application (Spring Boot + PostgreSQL + React)",
  "scripts": {
    "dev:frontend": "yarn --cwd frontend dev",
    "build:frontend": "yarn --cwd frontend build",
    "dev:backend": "cd backend && mvn spring-boot:run",
    "test:backend": "cd backend && mvn test",
    "db:up": "docker compose up -d db",
    "up": "docker compose up --build"
  }
}
