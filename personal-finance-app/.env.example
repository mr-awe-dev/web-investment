# Copy this file to .env and fill in real values: cp .env.example .env
# Never commit .env - it is ignored by .gitignore.

# --- Database (docker-compose reads DB_NAME / DB_USERNAME / DB_PASSWORD) ---
DB_NAME=personal_finance
DB_USERNAME=personal_finance
DB_PASSWORD=ganti-dengan-password-kuat-anda

# Only needed when running the backend outside docker-compose; docker-compose
# overrides this with jdbc:postgresql://db:5432/${DB_NAME}
DB_URL=jdbc:postgresql://localhost:5432/personal_finance

# --- Spring profiles ---
SPRING_PROFILES_ACTIVE=dev

# --- Security ---
# Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRATION_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
SERVER_PORT=8080

# --- Frontend ---
VITE_API_URL=http://localhost:8080

# --- Demo data ---
# Seeds the demo user and sample portfolio through the accounting engine.
# Keep true for local development, false in production.
SEED_DEMO_DATA=true