<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="appEnv" source="app.env" defaultValue="production"/>

  <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{39} : %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <timeZone>UTC</timeZone>
      <includeMdc>true</includeMdc>
      <customFields>{"service":"personal-finance","env":"${appEnv}"}</customFields>
      <fieldNames>
        <timestamp>@timestamp</timestamp>
        <version>[ignore]</version>
        <level>level</level>
        <thread>thread</thread>
        <logger>logger</logger>
        <message>message</message>
        <stackTrace>stack_trace</stackTrace>
      </fieldNames>
    </encoder>
  </appender>

  <springProfile name="dev | test">
    <root level="INFO">
      <appender-ref ref="PLAIN"/>
    </root>
  </springProfile>

  <springProfile name="!dev &amp; !test">
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>
</configuration>
